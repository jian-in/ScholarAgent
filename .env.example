# 把本文件复制一份改名为 .env,再填入你的真实 Key。
# .env 已被 .gitignore 忽略,不会被提交到 git,可以放心填。

# ―― 默认:DeepSeek(便宜好用,https://platform.deepseek.com 注册)――
LLM_BASE_URL=https://api.deepseek.com
# 在下面等号后面直接粘贴你的真实 Key(形如 sk-xxxxxxxx),等号后不要留空格。
# 没填 Key 时程序会自动进入离线演示模式,不会报错。
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 可选:发给 arXiv 的客户端标识。频繁做文献检索时建议附上联系邮箱。
# ARXIV_USER_AGENT=ScholarAgent/1.0 (mailto:your-email@example.com)
# OPENALEX_EMAIL=your-email@example.com
# ARXIV_SEARCH_BACKEND=openalex

# 本地 Ollama + RTX 4060 8GB 的长论文配置示例:
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=qwen3.5:9b-32k
#   CONVERSATION_MAX_CHARS=60000
#   TEAM_HANDOFF_MAX_CHARS=12000
#   PAPER_READER_CHUNK_CHARS=6000
#   PAPER_READER_MAX_STEPS=48

# 成本感知自动路由（策略不存在或不兼容时自动回退 RuleRouter）:
#   ROUTER_POLICY_PATH=data/router/policy.json
#   ROUTER_LAMBDA_TIME=0.15
#   ROUTER_LAMBDA_CALLS=0.10
#   ROUTER_LAMBDA_TOKEN=0.0

# 上下文压缩（旧工具结果不再每步整段重发,详见 README「上下文成本控制」）:
#   AGENT_CONTEXT_RECENT_OBSERVATIONS=2   # 最近几条工具结果保持原文
#   AGENT_CONTEXT_OLD_OBSERVATION_CHARS=600  # 更早的压到多少字符;0=关闭

# ―― 想换其他厂商:注释掉上面三行,改用下面对应的配置 ――
# 通义千问:
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
# 智谱 GLM:
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL=glm-4-air
# 本地 Ollama(以后跑本地模型用,不花钱):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen3:8b
#   LLM_API_KEY=ollama
